local function updateSpectateIndicator()
    if spectate.active and spectate.target and spectate.target.Parent then
        local disp = spectate.target.DisplayName
        if disp == "" or disp == nil then disp = spectate.target.Name end
        spectateIndicatorLabel.Text = "◉  Spectating: " .. disp
        if not spectateIndicator.Visible then
            spectateIndicator.Visible = true
            spectateIndicator.BackgroundTransparency = 1
            spectateIndicatorLabel.TextTransparency = 1
            tween(spectateIndicator, TweenInfo.new(0.22), { BackgroundTransparency = 0.05 })
            tween(spectateIndicatorLabel, TweenInfo.new(0.22), { TextTransparency = 0 })
        end
    else
        if spectateIndicator.Visible then
            tween(spectateIndicator, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
            tween(spectateIndicatorLabel, TweenInfo.new(0.18), { TextTransparency = 1 })
            task.delay(0.2, function()
                if not spectate.active then
                    spectateIndicator.Visible = false
                end
            end)
        end
    end
end

local function getCharacterHumanoid(player)
    if not player then return nil end
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function clearSpectateConnections()
    for _, conn in ipairs(spectate.connections) do
        pcall(function() conn:Disconnect() end)
    end
    spectate.connections = {}
end

local function refreshSpectateButtons()
    local target = spectate.active and spectate.target or nil
    for player, refs in pairs(spectateButtons) do
        if refs.btn and refs.btn.Parent then
            local isTarget = (player == target)
            refs.btn.Text = isTarget and "◉  Stop Spectating" or "◉  Spectate"
            tween(refs.btn, TweenInfo.new(0.2), {
                BackgroundColor3 = isTarget and THEME.DANGER or THEME.P_MAIN,
            })
            if refs.stroke then
                tween(refs.stroke, TweenInfo.new(0.2), {
                    Color = isTarget and THEME.DANGER_HI or THEME.P_GLOW,
                })
            end
        end
    end
end

local function stopSpectating(silent)
    if not spectate.active then return end
    spectate.active = false
    spectate.target = nil

    clearSpectateConnections()

    local camera = workspace.CurrentCamera
    if camera then
        local hum = getCharacterHumanoid(localPlayer)
        if hum then
            camera.CameraSubject = hum
        else
            localPlayer.CharacterAdded:Once(function(char)
                task.wait(0.15)
                if spectate.active then return end
                local newHum = char:FindFirstChildOfClass("Humanoid")
                if newHum and workspace.CurrentCamera then
                    workspace.CurrentCamera.CameraSubject = newHum
                end
            end)
        end
    end

    updateSpectateIndicator()
    refreshSpectateButtons()

    if not silent then
        showToast("◉  Spectate stopped")
    end
end

local function startSpectating(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then
        showToast("◉  Player unavailable")
        return
    end
    if targetPlayer == localPlayer then
        showToast("◉  Cannot spectate yourself")
        return
    end

    if spectate.active and spectate.target == targetPlayer then
        stopSpectating()
        return
    end

    if spectate.active then
        stopSpectating(true)
    end

    local targetHum = getCharacterHumanoid(targetPlayer)
    if not targetHum or targetHum.Health <= 0 then
        showToast("◉  Target has no active character")
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        showToast("◉  Camera unavailable")
        return
    end

    spectate.active = true
    spectate.target = targetPlayer
    camera.CameraSubject = targetHum

    table.insert(spectate.connections, targetPlayer.CharacterAdded:Connect(function()
        task.wait(0.15)
        if not spectate.active or spectate.target ~= targetPlayer then return end
        local hum = getCharacterHumanoid(targetPlayer)
        if hum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = hum
        end
    end))

    table.insert(spectate.connections, Players.PlayerRemoving:Connect(function(p)
        if spectate.active and spectate.target == p then
            stopSpectating()
        end
    end))

    table.insert(spectate.connections, localPlayer.CharacterAdded:Connect(function()
        task.wait(0.15)
        if not spectate.active or not spectate.target then return end
        local hum = getCharacterHumanoid(spectate.target)
        if hum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = hum
        end
    end))

    updateSpectateIndicator()
    refreshSpectateButtons()

    local disp = targetPlayer.DisplayName
    if disp == "" or disp == nil then disp = targetPlayer.Name end
    showToast("◉  Spectating " .. disp)
end

