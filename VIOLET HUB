            if state.walkSpeed.original == nil then state.walkSpeed.original = h.WalkSpeed end
            h.WalkSpeed = state.walkSpeed.value
        end
        local function disableWalkSpeed()
            local h = getHum(); if not h then return end
            if state.walkSpeed.original ~= nil then h.WalkSpeed = state.walkSpeed.original end
        end

        local function enableJumpPower()
            local h = getHum(); if not h then return end
