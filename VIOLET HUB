        local function switchTab(name)
            if not Pages[name] then return end
            if CurrentPage == name then return end
            if CurrentPage == "TARGETING" and name ~= "TARGETING" then
                pcall(function() stopViewing(false) end)
            end
            local oldPage = CurrentPage and Pages[CurrentPage]
            CurrentPage = name
            for tn in pairs(TabRefs) do applyTabVisual(tn) end
            moveIndicator(name, false)
            if oldPage then oldPage.Visible = false end
            local newPage = Pages[name]
            if newPage then
                newPage.Visible = true
                local sc = newPage:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
                sc.Parent = newPage
                if animEnabled then
                    sc.Scale = 0.96
                    tween(sc, 0.22, {Scale = 1}, Enum.EasingStyle.Quart)
                else
                    sc.Scale = 1
                end
                local sf = newPage:FindFirstChildOfClass("ScrollingFrame")
                if sf then pcall(function() sf.CanvasPosition = Vector2.new(0, 0) end) end
            end
        end

        for name, r in pairs(TabRefs) do
            pcall(function()
                r.button.MouseButton1Click:Connect(function() switchTab(name) end)
            end)
        end

        local function showHub()
            if hubVisible or opening then return end
            opening = true
            hubVisible = true
            local d = getDims()
            local targetPos = savedPosition or Hub.Position
            Hub.Position = targetPos + UDim2.fromOffset(0, 30)
            Hub.Visible = true
            if animEnabled then
                for _, entry in ipairs(staggerTargets) do
                    if entry.card and entry.card.Parent then
                        pcall(function()
                            entry.card.BackgroundTransparency = 1
                            if entry.stroke then entry.stroke.Transparency = 1 end
                        end)
                    end
                end
                Hub.Size = UDim2.fromOffset(0, 0)
                Hub.BackgroundTransparency = 1
                setBlur(isMobileScreen() and 8 or 14, 0.35)
                startRain()
                tween(Hub, 0.4, {
                    Size = UDim2.fromOffset(d.X, d.Y),
                    BackgroundTransparency = 0.05,
                    Position = targetPos
                }, Enum.EasingStyle.Quart)
                task.delay(0.18, function() if playStagger then pcall(playStagger) end end)
                task.delay(0.55, function() opening = false end)
            else
                for _, entry in ipairs(staggerTargets) do
                    if entry.card and entry.card.Parent then
                        pcall(function()
                            entry.card.BackgroundTransparency = entry.orig
                            if entry.stroke then entry.stroke.Transparency = entry.strokeOrig end
                        end)
                    end
                end
                Hub.Size = UDim2.fromOffset(d.X, d.Y)
                Hub.BackgroundTransparency = 0.05
                Hub.Position = targetPos
                startRain()
                opening = false
            end
        end

        local function hideHub(afterFn)
            if closing or not hubVisible then
                if afterFn then pcall(afterFn) end
                return
            end
            pcall(function() stopViewing(false) end)
            closing = true
            hubVisible = false
            savedPosition = Hub.Position
            stopRain()
            local function finalize()
                if Hub then Hub.Visible = false end
                closing = false
                if afterFn then pcall(afterFn) end
            end
            if animEnabled then
                fadeOutCards()
                task.delay(0.15, function()
                    tween(Hub, 0.3, {
                        Size = UDim2.fromOffset(0, 0),
                        BackgroundTransparency = 1,
                        Position = savedPosition + UDim2.fromOffset(0, 40)
                    })
                    setBlur(0, 0.3)
                end)
                task.delay(0.55, finalize)
            else
                setBlur(0, 0)
                finalize()
            end
        end

        local dragging, dragStart, startPos, activeDragInput = false, nil, nil, nil

        local function clampPosition(pos)
            local v = getViewportSize()
            local s = Hub.AbsoluteSize
            local x = pos.X.Scale * v.X + pos.X.Offset
            local y = pos.Y.Scale * v.Y + pos.Y.Offset
            x = math.clamp(x, 0, math.max(0, v.X - s.X))
            y = math.clamp(y, 0, math.max(0, v.Y - s.Y))
            return UDim2.fromOffset(x, y)
        end

        pcall(function()
            TitleBar.InputBegan:Connect(function(input)
                if opening or closing then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    dragStart = input.Position
                    startPos = Hub.Position
                    input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then dragging = false end
                    end)
                end
            end)
        end)
        pcall(function()
            TitleBar.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    activeDragInput = input
                end
            end)
        end)
        pcall(function()
            UserInputService.InputChanged:Connect(function(input)
                if input == activeDragInput and dragging and dragStart and startPos then
                    local delta = input.Position - dragStart
                    Hub.Position = clampPosition(UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    ))
                end
            end)
        end)

        pcall(function()
            local dn = LP.DisplayName or LP.Name
            DispName.Text = dn
            UserName.Text = "@" .. LP.Name
            PDisplay.Text = dn
            PUser.Text = LP.Name
            PUserId.Text = tostring(LP.UserId)
            PPlace.Text = tostring(game.PlaceId)
            local oka, age = pcall(function() return LP.AccountAge end)
            if oka and type(age) == "number" then
                local y = age / 365.25
                AgeText.Text = string.format("Account age: %d days (~%.1f years)", age, y)
                PAge.Text = string.format("%d d / %.1f y", age, y)
            else
                AgeText.Text = "Account age: N/A"
                PAge.Text = "N/A"
            end
            local okm, mem = pcall(function() return LP.MembershipType end)
            if okm and mem then
                local okg, str = pcall(function() return tostring(mem):gsub("Enum.MembershipType.", "") end)
                PMember.Text = okg and str or tostring(mem)
            else
                PMember.Text = "N/A"
            end
            task.spawn(function()
                local okt, t = pcall(function() return Players:GetUserThumbnailAsync(LP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150) end)
                if okt and t and Avatar and Avatar.Parent then pcall(function() Avatar.Image = t end) end
            end)
        end)

        local fpsFrames, fpsElapsed = 0, 0
        pcall(function()
            RunService.RenderStepped:Connect(function(dt)
                pcall(function()
                    fpsFrames = fpsFrames + 1
                    fpsElapsed = fpsElapsed + dt
                    if fpsElapsed >= 0.5 then
                        local fps = math.floor(fpsFrames / fpsElapsed)
                        local txt = tostring(fps)
                        if FpsValue and FpsValue.Parent then FpsValue.Text = txt end
                        if SFpsValue and SFpsValue.Parent then SFpsValue.Text = txt end
                        local col = (fps >= 50 and C.Colors.Green) or (fps >= 30 and C.Colors.AccentGlow) or C.Colors.Close
                        if FpsValue and FpsValue.Parent then FpsValue.TextColor3 = col end
                        if SFpsValue and SFpsValue.Parent then SFpsValue.TextColor3 = col end
                        fpsFrames = 0
                        fpsElapsed = 0
                    end
                end)
            end)
        end)

        local running = true
        pcall(function()
            SG.AncestryChanged:Connect(function()
                if not SG.Parent then running = false end
            end)
        end)

        task.spawn(function()
            while running and SG and SG.Parent do
                pcall(function()
                    local ok, p = pcall(function() return LP:GetNetworkPing() end)
                    local txt, col
                    if ok and type(p) == "number" and p > 0 then
                        txt = tostring(math.floor(p * 1000)) .. " ms"
                        col = C.Colors.Text
                    else
                        txt = "N/A"
                        col = C.Colors.TextDim
                    end
                    if PingValue and PingValue.Parent then PingValue.Text = txt; PingValue.TextColor3 = col end
                    if SPingValue and SPingValue.Parent then SPingValue.Text = txt; SPingValue.TextColor3 = col end
                end)
                task.wait(1)
            end
        end)

        task.spawn(function()
            while running and SG and SG.Parent do
                pcall(function()
                    if CountValue and CountValue.Parent then CountValue.Text = getPlayerCount() end
                end)
                task.wait(3)
            end
        end)

        task.spawn(function()
            while running and SG and SG.Parent do
                pcall(function()
                    if UptimeValue and UptimeValue.Parent then UptimeValue.Text = formatUptime() end
                    if ActiveFeaturesValue and ActiveFeaturesValue.Parent then ActiveFeaturesValue.Text = tostring(countActive()) .. " / 10" end
                end)
                task.wait(1)
            end
        end)

        pcall(function()
            ResetPosBtn.MouseButton1Click:Connect(function()
                local d = getDims()
                local v = getViewportSize()
                local tg = UDim2.fromOffset((v.X - d.X) / 2, (v.Y - d.Y) / 2)
                if animEnabled then tween(Hub, 0.25, {Position = tg}) else Hub.Position = tg end
                savedPosition = tg
            end)
        end)

        local animBusy = false
        pcall(function()
            AnimBtn.MouseButton1Click:Connect(function()
                if animBusy then return end
                animBusy = true
                animEnabled = not animEnabled
                tween(AnimTrack, 0.2, {BackgroundColor3 = animEnabled and C.Colors.Green or C.Colors.TextDim})
                tween(AnimKnob, 0.2, {Position = animEnabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
                task.delay(0.25, function() animBusy = false end)
            end)
        end)

        pcall(function()
            Toggle.MouseButton1Click:Connect(function()
                if opening or closing then return end
                if hubVisible then hideHub() else showHub() end
            end)
        end)
        pcall(function()
            HideBtn.MouseButton1Click:Connect(function() hideHub() end)
        end)
        pcall(function()
            CloseBtn.MouseButton1Click:Connect(function()
                if closing then return end
                hideHub(function()
                    running = false
                    pcall(cleanupAll)
                    pcall(stopRain)
                    pcall(function() stopViewing(false) end)
                    if HubBlur then pcall(function() HubBlur:Destroy() end); HubBlur = nil end
                    if backdropOverlay then pcall(function() backdropOverlay:Destroy() end) end
                    if HubShadow then pcall(function() HubShadow:Destroy() end); HubShadow = nil end
                    pcall(function() SG:Destroy() end)
                end)
            end)
        end)

        local function updateGrids()
            local isMob = isMobileScreen()
            pcall(function()
                if isMob then
                    serverGridLayout.CellSize = UDim2.new(1, 0, 0, 46)
                    serverGridLayout.FillDirection = Enum.FillDirection.Vertical
                else
                    serverGridLayout.CellSize = UDim2.new(0.5, -4, 0, 46)
                    serverGridLayout.FillDirection = Enum.FillDirection.Horizontal
                end
            end)
            pcall(function()
                if isMob then
                    statsGridLayout.CellSize = UDim2.new(1, 0, 0, 46)
                    statsGridLayout.FillDirection = Enum.FillDirection.Vertical
                else
                    statsGridLayout.CellSize = UDim2.new(0.5, -4, 0, 46)
                    statsGridLayout.FillDirection = Enum.FillDirection.Horizontal
                end
            end)
        end
        updateGrids()

        local function updateResponsive(resizeHub)
            local isMob = isMobileScreen()
            local newSidebarW = isMob and 48 or 110
            Sidebar.Size = UDim2.new(0, newSidebarW, 1, -TITLE_H)
            Content.Position = UDim2.new(0, newSidebarW, 0, TITLE_H)
            Content.Size = UDim2.new(1, -newSidebarW, 1, -TITLE_H)
            for _, r in pairs(TabRefs) do r.label.Visible = not isMob end
            if resizeHub and hubVisible and not opening and not closing then
                local d = getDims()
                Hub.Size = UDim2.fromOffset(d.X, d.Y)
                Hub.Position = clampPosition(Hub.Position)
                savedPosition = Hub.Position
            end
            updateGrids()
            if CurrentPage then
                task.defer(function() if CurrentPage then moveIndicator(CurrentPage, true) end end)
            end
        end

        pcall(function()
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                updateResponsive(true)
            end)
        end)

        switchTab("HOME")
        updateResponsive(false)
        showHub()
        log("Build OK — v" .. SCRIPT_INFO.VERSION)
    end)

    if not buildOk then
        warnLog("Build failed: " .. tostring(buildErr))
        notify("VIOLET HUB", "Build failed — check console.")
        return
    end

    notify("VIOLET HUB", "Loaded v" .. SCRIPT_INFO.VERSION .. " — press V to open")
end

pcall(main)
