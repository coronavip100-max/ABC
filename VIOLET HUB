local function updateSpectateIndicator()
    local shouldShow = spectate.active and spectate.target
        and spectate.target.Parent and not windowHidden
    if shouldShow then
        spectateIndicatorLabel.Text = "◉  Spectating: " .. displayNameOf(spectate.target)
        if not spectateIndicator.Visible then
            spectateIndicator.Visible = true
            spectateIndicator.BackgroundTransparency = 1
            spectateIndicatorLabel.TextTransparency = 1
            spectateStopBtn.BackgroundTransparency = 1
            tween(spectateIndicator, TweenInfo.new(0.22), { BackgroundTransparency = 0.05 })
            tween(spectateIndicatorLabel, TweenInfo.new(0.22), { TextTransparency = 0 })
            tween(spectateStopBtn, TweenInfo.new(0.22), { BackgroundTransparency = 0 })
        end
    else
        if spectateIndicator.Visible then
            tween(spectateIndicator, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
            tween(spectateIndicatorLabel, TweenInfo.new(0.18), { TextTransparency = 1 })
            tween(spectateStopBtn, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
            task.delay(0.22, function()
                if not spectate.active or windowHidden then
                    spectateIndicator.Visible = false
                end
            end)
        end
    end
    if floatingBadge then floatingBadge.Visible = spectate.active end
end

local function bindCameraToTarget()
    if not spectate.active or not spectate.target then return end
    if not spectate.target.Parent then
        spectate.active = false; spectate.target = nil
        if spectate.connection then
            pcall(function() spectate.connection:Disconnect() end)
            spectate.connection = nil
        end
        local cam = workspace.CurrentCamera
        if cam then
            local myHum = getHumanoid(localPlayer)
            if myHum then cam.CameraSubject = myHum end
        end
        updateSpectateIndicator(); refreshSpectateButtons()
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local hum = getHumanoid(spectate.target)
    if hum then cam.CameraSubject = hum end
end

local function stopSpectating(reason)
    if not spectate.active then return end
    spectate.active = false; spectate.target = nil
    if spectate.connection then
        pcall(function() spectate.connection:Disconnect() end)
        spectate.connection = nil
    end
    local cam = workspace.CurrentCamera
    if cam then
        local myHum = getHumanoid(localPlayer)
        if myHum then
            cam.CameraSubject = myHum
        else
            localPlayer.CharacterAdded:Once(function(char)
                task.wait(0.15)
                if spectate.active then return end
                local newHum = char:FindFirstChildOfClass("Humanoid")
                if newHum and workspace.CurrentCamera then
                    workspace.CurrentCamera.CameraSubject = newHum
                end
            end)
        end
    end
    updateSpectateIndicator(); refreshSpectateButtons()
    if reason and reason ~= "silent" then showToast("◉  " .. reason) end
end

local function startSpectating(targetPlayer)
    if not targetPlayer then return end
    if targetPlayer == localPlayer then showToast("◉  Cannot spectate yourself"); return end
    if not targetPlayer.Parent then showToast("◉  Player unavailable"); return end
    if spectate.active and spectate.target == targetPlayer then stopSpectating(); return end
    if spectate.connection then
        pcall(function() spectate.connection:Disconnect() end)
        spectate.connection = nil
    end
    spectate.active = true; spectate.target = targetPlayer
    local hum = getHumanoid(targetPlayer)
    local cam = workspace.CurrentCamera
    if hum and cam then cam.CameraSubject = hum end
    spectate.connection = targetPlayer.CharacterAdded:Connect(function(char)
        if not spectate.active or spectate.target ~= targetPlayer then return end
        task.wait(0.1)
        if not spectate.active or spectate.target ~= targetPlayer then return end
        local newHum = char:FindFirstChildOfClass("Humanoid")
        if newHum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = newHum
        end
    end)
    updateSpectateIndicator(); refreshSpectateButtons()
    local disp = displayNameOf(targetPlayer)
    if hum then showToast("◉  Spectating " .. disp)
    else showToast("◉  Waiting for " .. disp .. "…") end
end

