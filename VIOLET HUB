    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = THEME.BG_CARD,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        LayoutOrder = order,
        ZIndex = 4,
    }, parent)
    addCorner(10, row)
    addStroke(THEME.BORDER, 1, 0.2, row)

    create("TextLabel", {
        Size = UDim2.new(1, -76, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        Font = FONT.Medium, TextSize = 12,
        TextColor3 = THEME.TX_MAIN,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5,
    }, row)

    local toggle = create("TextButton", {
        Size = UDim2.fromOffset(44, 22),
        Position = UDim2.new(1, -56, 0.5, -11),
        BackgroundColor3 = initialValue and THEME.P_MAIN or THEME.BG_CARD_HI,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 5,
    }, row)
    addCorner(11, toggle)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = initialValue and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = THEME.TX_MAIN,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, toggle)
    addCorner(8, knob)

    local isOn = initialValue
    local function setOn(v, fire)
        isOn = v
        tween(toggle, TweenInfo.new(0.18), {
            BackgroundColor3 = v and THEME.P_MAIN or THEME.BG_CARD_HI,
