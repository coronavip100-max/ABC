-- Cache for Map Name (GetProductInfo is HTTP — call once)
local cachedMapName = nil
local function resolveMapName()
    if cachedMapName then return cachedMapName end
    local name = nil
    -- Try GetProductInfo (HTTP — may be blocked)
    pcall(function()
        local info = MarketplaceService:GetProductInfo(game.PlaceId)
        if info and info.Name and info.Name ~= "" then
            name = info.Name
        end
    end)
    -- Fallback to game.Name
    if not name or name == "" then
        name = (game.Name and game.Name ~= "") and game.Name or nil
    end
    cachedMapName = name
    return name
end

local function updateServerInfo()
    -- Players (dynamic)
    if serverInfoLabels.players then
        local cur = #Players:GetPlayers()
        local max = Players.MaxPlayers
        serverInfoLabels.players.Text = cur .. " / " .. max
    end

    -- Game Name
    if serverInfoLabels.gameName then
        serverInfoLabels.gameName.Text = (game.Name and game.Name ~= "")
            and game.Name or "N/A"
    end

    -- Map Name
    if serverInfoLabels.mapName then
        local mapName = resolveMapName()
        serverInfoLabels.mapName.Text = mapName or "N/A"
    end

    -- Server ID (JobId — empty in Studio)
    if serverInfoLabels.serverId then
        local ok, jobId = pcall(function() return game.JobId end)
        if ok and jobId and jobId ~= "" then
            serverInfoLabels.serverId.Text = jobId
        else
