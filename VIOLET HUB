            for i, entry in ipairs(staggerTargets) do
                pcall(function()
                    if entry.card and entry.card.Parent then
                        entry.card.BackgroundTransparency = 1
                        if entry.stroke then entry.stroke.Transparency = 1 end
                        task.delay(i * 0.04, function()
                            if entry.card and entry.card.Parent then
                                tween(entry.card, 0.28, {BackgroundTransparency = entry.orig})
                                if entry.stroke then
                                    tween(entry.stroke, 0.28, {Transparency = entry.strokeOrig})
                                end
                            end
                        end)
                    end
                end)
            end
        end

