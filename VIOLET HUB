    local function scaleTo(f, dur)
        tween(btn, TweenInfo.new(dur), {
            Size = UDim2.new(
                baseSize.X.Scale * f, baseSize.X.Offset * f,
                baseSize.Y.Scale * f, baseSize.Y.Offset * f
            )
        })
    end
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            pressing = true
            scaleTo(0.94, 0.08)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            if pressing then
                pressing = false
                scaleTo(1, 0.14)
            end
        end
    end)
end

