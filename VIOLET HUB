local function addStagger(card)
    if not card then return end
    local stroke = nil
    pcall(function() stroke = card:FindFirstChildOfClass("UIStroke") end)
    table.insert(staggerTargets, {
        card = card,
        orig = card.BackgroundTransparency,
        stroke = stroke,
        strokeOrig = stroke and stroke.Transparency or 0.5,
    })
end

