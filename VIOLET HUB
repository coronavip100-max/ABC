local function showToast(message)
    local parentGui = screenGui or playerGui
    local toast = create("Frame", {
        Name = "Toast", Size = UDim2.fromOffset(240, 40),
        Position = UDim2.new(0.5, -120, 0, -58),
        BackgroundColor3 = THEME.BG_CARD, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 100,
    }, parentGui)
    addCorner(12, toast)
    local toastStroke = addStroke(THEME.P_BRIGHT, 1, 1, toast)
    local label = create("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = message, Font = FONT.Bold, TextSize = 12,
        TextColor3 = THEME.TX_MAIN, TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101,
    }, toast)
    tween(toast, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -120, 0, 20), BackgroundTransparency = 0.02,
    })
    tween(toastStroke, TweenInfo.new(0.3), { Transparency = 0.4 })
    tween(label, TweenInfo.new(0.3), { TextTransparency = 0 })
    task.delay(2.4, function()
        if not toast or not toast.Parent then return end
        tween(toast, TweenInfo.new(0.3), {
            Position = UDim2.new(0.5, -120, 0, -58), BackgroundTransparency = 1,
        })
        tween(toastStroke, TweenInfo.new(0.3), { Transparency = 1 })
        tween(label, TweenInfo.new(0.3), { TextTransparency = 1 })
        task.delay(0.35, function() if toast then toast:Destroy() end end)
    end)
end

local function copyText(text, label)
    if typeof(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)
        if ok then showToast("✦ " .. (label or "Copied")); return true end
    end
    showToast("✦ " .. text); return false
end

local function openURL(url)
    if typeof(openbrowser) == "function" then
        local ok = pcall(openbrowser, url)
        if ok then showToast("◈ Opening Discord…"); return end
    end
    if typeof(setclipboard) == "function" then
        local ok = pcall(setclipboard, url)
        if ok then showToast("◈ Link copied — paste in browser"); return end
    end
    showToast("◈ " .. url)
end

