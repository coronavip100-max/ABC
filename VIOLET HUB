        Size = UDim2.new(1, 0, 0, 8),
        Position = UDim2.new(0, 0, 0.5, -4),
        BackgroundColor3 = THEME.BG_CARD_HI,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, hitbox)
    addCorner(4, bar)

    local fill = create("Frame", {
        Size = UDim2.new(initialValue / 100, 0, 1, 0),
        BackgroundColor3 = THEME.P_BRIGHT,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, bar)
    addCorner(4, fill)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(initialValue / 100, -9, 0.5, -9),
        BackgroundColor3 = THEME.TX_MAIN,
        BorderSizePixel = 0,
        ZIndex = 7,
    }, bar)
    addCorner(9, knob)
    addStroke(THEME.P_GLOW, 1.5, 0, knob)

    local current = initialValue
    local dragging = false

    local function apply(v, fire)
        v = math.clamp(math.floor(v + 0.5), 0, 90)
        current = v
        tween(fill, TweenInfo.new(0.08), { Size = UDim2.new(v / 100, 0, 1, 0) })
        tween(knob, TweenInfo.new(0.08), { Position = UDim2.new(v / 100, -9, 0.5, -9) })
        valueLbl.Text = v .. "%"
        if fire and onChange then onChange(v) end
    end

    local function fromInput(input)
        local pos = bar.AbsolutePosition
        local size = bar.AbsoluteSize
        if size.X <= 0 then return end
        local rel = (input.Position.X - pos.X) / size.X
        apply(rel * 100, true)
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return { setValue = function(v) apply(v, false) end, get = function() return current end }
end

