    fadeTo(1, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
        root.Visible = false
        floatingBtn.Visible = true
        floatingBtn.Size = UDim2.fromOffset(0, 0)
        tween(floatingBtn, EASE.BACK, { Size = UDim2.fromOffset(48, 48) })
    end)
end

local function showWindow()
    windowHidden = false
    floatingBtn.Visible = false
    root.Visible = true
    applyBlur()
    setAllTransparency(1)
    fadeTo("orig", 0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
        mainStroke.Enabled = true
        if settings.glow then
            tween(outerGlow, TweenInfo.new(0.3), { BackgroundTransparency = 0.85 })
        end
    end)
    if spectate.active then updateSpectateIndicator() end
    updateServerInfo()  -- refresh players count when reopening
end
