            local r = TabRefs[name]
            if not r then return end
            pcall(function()
                local y = r.button.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y
                if instant or not animEnabled then
                    Indicator.Position = UDim2.new(0, 0, 0, y)
                else
                    tween(Indicator, 0.25, {Position = UDim2.new(0, 0, 0, y)}, Enum.EasingStyle.Quart)
                end
            end)
