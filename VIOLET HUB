        local toastTok = 0
        local function toast(msg, color)
            toastTok = toastTok + 1
            local myTok = toastTok
            Toast.Text = tostring(msg)
            Toast.TextColor3 = color or C.Colors.Text
            Toast.Visible = true
            Toast.Position = UDim2.new(0.5, -120, 1, 40)
            tween(Toast, 0.2, {Position = UDim2.new(0.5, -120, 1, -50)})
            task.delay(2, function()
                if toastTok ~= myTok then return end
                tween(Toast, 0.2, {Position = UDim2.new(0.5, -120, 1, 40)})
                task.delay(0.25, function()
                    if toastTok == myTok then Toast.Visible = false end
                end)
            end)
        end

