        local function setViewButtonState(btn, isViewing)
            if not btn or not btn.Parent then return end
            btn.Text = isViewing and "STOP VIEWING" or "VIEW PLAYER"
            btn.BackgroundColor3 = isViewing and C.Colors.Close or C.Colors.AccentDeep
            btn.TextColor3 = isViewing and C.Colors.Text or C.Colors.AccentGlow
            btn.BackgroundTransparency = 0.2
        end

        local function restoreCamera()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local target = viewState.originalSubject
            if not target and LP.Character then
                target = LP.Character:FindFirstChildOfClass("Humanoid")
            end
            if target then
                pcall(function() cam.CameraSubject = target end)
            end
            viewState.originalSubject = nil
        end

        local function stopViewing(showToast, keepOriginal)
            if not viewState.active then return end
            viewState.active = false
            if viewState.monitorConn then
                pcall(function() viewState.monitorConn:Disconnect() end)
                viewState.monitorConn = nil
            end
            if not keepOriginal then
                restoreCamera()
            end
            if viewState.button then
