local function onViewportChange()
    local w, h = computeWindowSize()
    if not dragging then
        root.Size = UDim2.fromOffset(w, h)
        local vp = getViewport()
        local posX = root.Position.X.Scale * vp.X + root.Position.X.Offset
        local posY = root.Position.Y.Scale * vp.Y + root.Position.Y.Offset
        if posX < -w * 0.5 then posX = -w * 0.5 end
        if posX > vp.X - 40 then posX = vp.X - 40 end
        if posY < -h * 0.5 then posY = -h * 0.5 end
        if posY > vp.Y - 40 then posY = vp.Y - 40 end
        root.Position = UDim2.fromOffset(posX, posY)
    end
end

local function bindCamera(cam)
    if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChange) end
end
