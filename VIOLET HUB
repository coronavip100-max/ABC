local function getViewport()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(800, 600)
end
local function computeWindowSize()
    local vp = getViewport()
    local w = math.clamp(vp.X * 0.80, 280, 400)
    local h = math.clamp(vp.Y * 0.70, 340, 500)
    return math.floor(w), math.floor(h)
end
local function centerPosition(w, h)
    local vp = getViewport()
    return UDim2.fromOffset(math.floor((vp.X - w) / 2), math.floor((vp.Y - h) / 2))
end

