local function createPage(id, scrolling)
    local class = scrolling and "ScrollingFrame" or "Frame"
    local props = {
        Name = id .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
        BorderSizePixel = 0,
        ZIndex = 4,
    }
    if scrolling then
        props.ScrollBarThickness = 3
        props.ScrollBarImageColor3 = THEME.P_BRIGHT
        props.CanvasSize = UDim2.new(0, 0, 0, 0)
        props.AutomaticCanvasSize = Enum.AutomaticSize.Y
        props.ScrollingDirection = Enum.ScrollingDirection.Y
    end
    local page = create(class, props, pagesContainer)
    tabPages[id] = page
    return page
end

