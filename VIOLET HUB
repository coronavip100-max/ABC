            local cam = workspace.CurrentCamera
            if not cam then return false end
            local char = player and player.Character
            if not char then
                toast("Character not ready", C.Colors.Close)
                if overrideOriginal then
                    pcall(function() cam.CameraSubject = overrideOriginal end)
                end
                return false
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then
                toast("Character not ready", C.Colors.Close)
                if overrideOriginal then
                    pcall(function() cam.CameraSubject = overrideOriginal end)
                end
                return false
            end
            if overrideOriginal ~= nil then
                viewState.originalSubject = overrideOriginal
            elseif viewState.originalSubject == nil then
                local currentSubject = cam.CameraSubject
                if not currentSubject and LP.Character then
                    currentSubject = LP.Character:FindFirstChildOfClass("Humanoid")
                end
                viewState.originalSubject = currentSubject
            end
            local ok = pcall(function() cam.CameraSubject = hum end)
            if not ok then
                toast("Cannot switch camera (locked)", C.Colors.Close)
                if overrideOriginal then
                    pcall(function() cam.CameraSubject = overrideOriginal end)
                end
                return false
            end
            viewState.active = true
            viewState.targetPlayer = player
            viewState.button = btn
            setViewButtonState(btn, true)
            toast("Viewing " .. player.Name, C.Colors.Green)

            if viewState.monitorConn then
