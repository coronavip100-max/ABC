        -- ============ Instant Search ============
        local searchDebounce = 0
        local lastQuery = ""

        local function doSearch(query)
            query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if query == lastQuery then return end
            lastQuery = query

            clearResults()
            selectedCard = nil

            if #query < 2 then
                searchStatus.Text = "Type at least 2 characters..."
                searchStatus.TextColor3 = C.Colors.TextDim
                return
            end

            searchStatus.Text = "Searching..."
            searchStatus.TextColor3 = C.Colors.AccentGlow

            local localMatches = {}
            local qLower = query:lower()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then
                    local lowerName = plr.Name:lower()
                    local lowerDisplay = (plr.DisplayName or ""):lower()
                    if lowerName:sub(1, #qLower) == qLower or lowerDisplay:sub(1, #qLower) == qLower then
                        table.insert(localMatches, {
                            Id = plr.UserId,
                            Username = plr.Name,
                            DisplayName = plr.DisplayName
                        })
                    end
                end
            end

            if #localMatches > 0 then
                for i, info in ipairs(localMatches) do
                    createResultCard(info, i, true)
                end
                searchStatus.Text = "Found " .. #localMatches .. " in this server."
                searchStatus.TextColor3 = C.Colors.Green
                return
            end

            task.spawn(function()
                local ok, userId = pcall(function()
                    return Players:GetUserIdFromNameAsync(query)
                end)
                if not ok or not userId or userId <= 0 then
                    searchStatus.Text = "No exact match. Try full username."
                    searchStatus.TextColor3 = C.Colors.Yellow
                    return
                end

                local ok2, infos = pcall(function()
                    return UserService:GetUserInfosByUserIdsAsync({userId})
                end)

                if not ok2 or not infos or #infos == 0 then
                    searchStatus.Text = "API error or user not found."
                    searchStatus.TextColor3 = C.Colors.Close
                    return
                end

                local info = infos[1]
                local inServer = Players:GetPlayerByUserId(info.Id) ~= nil
                createResultCard(info, 1, inServer)
                searchStatus.Text = "Found 1 result (exact match)."
                searchStatus.TextColor3 = C.Colors.Green
            end)
        end

        pcall(function()
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local txt = searchBox.Text
                if #txt < 2 then
                    searchDebounce = tick()
                    doSearch(txt)
                    return
                end
                local myId = tick()
                searchDebounce = myId
                task.delay(0.4, function()
                    if searchDebounce ~= myId then return end
                    doSearch(txt)
                end)
            end)
        end)

