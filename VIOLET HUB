                state.jumpPower.original = {
                    useJumpPower = h.UseJumpPower,
                    jumpPower = h.JumpPower,
                    jumpHeight = h.JumpHeight
                }
            end
            pcall(function() h.UseJumpPower = true end)
            pcall(function() h.JumpPower = state.jumpPower.value end)
        end
        local function disableJumpPower()
            local h = getHum(); if not h then return end
            local orig = state.jumpPower.original
            if orig then
                pcall(function() h.UseJumpPower = orig.useJumpPower end)
                if orig.useJumpPower then
                    pcall(function() h.JumpPower = orig.jumpPower end)
                else
                    pcall(function() h.JumpHeight = orig.jumpHeight end)
                end
            end
        end

        local function enableFly()
            if state.fly.conn then state.fly.conn:Disconnect(); state.fly.conn = nil end
            if state.fly.bv then state.fly.bv:Destroy(); state.fly.bv = nil end
            if state.fly.bg then state.fly.bg:Destroy(); state.fly.bg = nil end
            local root = getRoot(); local h = getHum()
            if not root or not h then return end
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = root
            state.fly.bv = bv
            local bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bg.P = 1000
            bg.D = 50
            bg.CFrame = root.CFrame
            bg.Parent = root
            state.fly.bg = bg
            state.fly.origWalkSpeed = h.WalkSpeed
            pcall(function() h.WalkSpeed = 0 end)
            state.fly.conn = RunService.Heartbeat:Connect(function()
                if not state.fly.on then return end
                if not bv.Parent or not bg.Parent then return end
                local h2 = getHum(); local cam = workspace.CurrentCamera
                if not h2 or not cam then return end
                local mv = Vector3.new(0, 0, 0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv = mv - Vector3.new(0, 1, 0) end
                if mv.Magnitude < 0.1 then
                    local md = h2.MoveDirection
                    if md.Magnitude > 0.1 then mv = md end
                end
                local spd = state.fly.value
                if mv.Magnitude > 0 then bv.Velocity = mv.Unit * spd else bv.Velocity = Vector3.new(0, 0, 0) end
                bg.CFrame = cam.CFrame
            end)
        end
        local function disableFly()
            if state.fly.conn then state.fly.conn:Disconnect(); state.fly.conn = nil end
