local BLUR_SIZE = 20

local function applyBlur()
    if blurObj and blurObj.Parent then return end
    local ok = pcall(function()
        local existing = Lighting:FindFirstChild("LYNEX_HUB_Blur")
        if existing and existing:IsA("BlurEffect") then
            existing.Size = BLUR_SIZE
            blurObj = existing
            return
        end
        local b = Instance.new("BlurEffect")
        b.Name = "LYNEX_HUB_Blur"
        b.Size = BLUR_SIZE
        b.Parent = Lighting
        blurObj = b
    end)
    if not ok then blurObj = nil end
end

local function removeBlur()
    if blurObj and blurObj.Parent then
        pcall(function() blurObj:Destroy() end)
    end
    blurObj = nil
end

