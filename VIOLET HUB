local loadBusy = false

local function fetchUrl(url)
    -- Try common executor HTTP APIs
    if typeof(fluxus) == "table" and typeof(fluxus.request) == "function" then
        local ok, resp = pcall(fluxus.request, { Url = url, Method = "GET" })
        if ok and resp and resp.Body then return resp.Body end
    end
    if typeof(syn) == "table" and typeof(syn.request) == "function" then
        local ok, resp = pcall(syn.request, { Url = url, Method = "GET" })
        if ok and resp and resp.Body then return resp.Body end
    end
    if typeof(http_request) == "function" then
        local ok, resp = pcall(http_request, { Url = url, Method = "GET" })
        if ok and resp and resp.Body then return resp.Body end
    end
    if typeof(request) == "function" then
        local ok, resp = pcall(request, { Url = url, Method = "GET" })
        if ok and resp and resp.Body then return resp.Body end
    end
    -- HttpService fallback (rarely works in executors)
    local ok, body = pcall(function()
        return game:GetService("HttpService"):GetAsync(url)
    end)
    if ok and body then return body end
    return nil
end

local function loadAutoFishScript()
    local body = fetchUrl(AUTO_FISH_URL)
    if not body then
        return false, "Download failed (no HTTP executor)"
    end
    if typeof(loadstring) ~= "function" then
        return false, "loadstring unavailable"
    end
    local fn, compileErr = loadstring(body)
    if not fn then
        return false, "Compile error: " .. tostring(compileErr)
    end
    local ok, runErr = pcall(fn)
    if not ok then
        return false, "Runtime error: " .. tostring(runErr)
    end
    return true
end

