local origTransparency = {}
local function scanTransparency(obj)
    if obj:IsA("GuiObject") then
        local snap = {}
        if obj:IsA("Frame") or obj:IsA("ScrollingFrame")
           or obj:IsA("TextButton") or obj:IsA("ImageButton") then
            snap.BackgroundTransparency = obj.BackgroundTransparency
        end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            snap.TextTransparency = obj.TextTransparency
            snap.TextStrokeTransparency = obj.TextStrokeTransparency
        end
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            snap.ImageTransparency = obj.ImageTransparency
        end
        if obj:IsA("TextBox") then snap.TextTransparency = obj.TextTransparency end
        if next(snap) then origTransparency[obj] = snap end
    end
    for _, c in ipairs(obj:GetChildren()) do scanTransparency(c) end
end
scanTransparency(root)

local function setAllTransparency(value)
    for obj, snap in pairs(origTransparency) do
        if obj and obj.Parent then
            for k in pairs(snap) do obj[k] = value end
        end
    end
end

local function fadeTo(value, duration, style, direction, onDone)
    if not settings.animations then duration = 0; style = Enum.EasingStyle.Linear end
    local inf = TweenInfo.new(duration, style, direction)
    local tweens, remaining = {}, 0
    for obj, snap in pairs(origTransparency) do
        if obj and obj.Parent then
            local target = {}
            for k in pairs(snap) do
                target[k] = (value == "orig") and snap[k] or value
            end
            table.insert(tweens, TweenService:Create(obj, inf, target))
            remaining += 1
        end
    end
    if remaining == 0 then if onDone then onDone() end; return end
    for _, t in ipairs(tweens) do
        t.Completed:Once(function()
            remaining -= 1
            if remaining <= 0 and onDone then onDone() end
        end)
        t:Play()
    end
end

