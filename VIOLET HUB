            local h = getHum(); if not h then return end
            state.doubleJump.airJumpsUsed = 0
            state.doubleJump.lastGroundAt = tick()
            state.doubleJump.conn1 = h.StateChanged:Connect(function(_, newState)
                if newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running or newState == Enum.HumanoidStateType.RunningNoPhysics then
                    state.doubleJump.lastGroundAt = tick()
                    state.doubleJump.airJumpsUsed = 0
                end
            end)
            state.doubleJump.conn2 = UserInputService.JumpRequest:Connect(function()
                if not state.doubleJump.on then return end
                local h2 = getHum(); if not h2 then return end
                local inAir = h2.FloorMaterial == Enum.Material.Air
                local timeOK = (tick() - state.doubleJump.lastGroundAt) > 0.2
                if inAir and timeOK and state.doubleJump.airJumpsUsed < 1 then
                    state.doubleJump.airJumpsUsed = state.doubleJump.airJumpsUsed + 1
                    pcall(function() h2:ChangeState(Enum.HumanoidStateType.Jumping) end)
                end
            end)
        end
