function applyWindowTransparency(pct)
    settings.transparency = math.clamp(pct, 0, 90)
    local t = settings.transparency / 100
    local function setTransp(obj, val)
        if origTransparency[obj] then origTransparency[obj].BackgroundTransparency = val end
        if not windowHidden then obj.BackgroundTransparency = val end
    end
    setTransp(main, t)
    setTransp(header, math.min(1, t + 0.02))
    setTransp(sidebar, math.min(1, t + 0.10))
end

function applyGlowState()
    if settings.glow then
        if not windowHidden then
            tween(outerGlow, TweenInfo.new(0.25), { BackgroundTransparency = 0.85 })
        end
    else
        tween(outerGlow, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
    end
end

